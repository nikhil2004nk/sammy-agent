datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum ConnectionStatus {
  ACTIVE
  ERROR
  PENDING
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  REQUIRES_ACTION
}

enum ExecutionNodeStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionNodeType {
  REASONING
  TOOL
  PLANNER
  WORKFLOW
  APPROVAL
  MESSAGE
  EVENT
  MEMORY_READ
  MEMORY_WRITE
  AGENT
  LLM
  CONTEXT
  SUBGRAPH
  ROUTER
  CONDITION
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
  DEVELOPER
}

enum MessagePartType {
  TEXT
  IMAGE
  CODE
  TOOL_CALL
  TOOL_RESULT
  THINKING
  FILE
}

enum MessagePartStatus {
  STREAMING
  COMPLETE
  FAILED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  DISABLED
  DEPRECATED
}

enum AgentHealthStatus {
  HEALTHY
  UNHEALTHY
  MAINTENANCE
}

// -------------------------------------------------------------
// Identity & Workspace Foundation
// -------------------------------------------------------------

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  passwordHash  String
  name          String?
  emailVerified Boolean   @default(false)
  avatar        String?
  preferences   Json?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  deviceName       String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  settings  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  members       WorkspaceMember[]
  connections   Connection[]
  agents        Agent[]
  conversations Conversation[]
  mcpServers    MCPServer[]
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// -------------------------------------------------------------
// Connections & Integrations
// -------------------------------------------------------------

model Connection {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @db.Uuid
  provider    String // e.g., 'gmail', 'github'
  status      ConnectionStatus @default(PENDING)
  metadata    Json? // Provider metadata
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentials Credential[]
}

model Credential {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId          String    @db.Uuid
  encryptedAccessToken  String?   @db.Text
  encryptedRefreshToken String?   @db.Text
  providerAccountId     String?
  accountEmail          String?
  displayName           String?
  scopes                String[]
  expiresAt             DateTime?
  lastRefreshedAt       DateTime?
  lastValidatedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model MCPServer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  url         String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tools     Tool[]
}

model Tool {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mcpServerId String?  @db.Uuid
  name        String
  version     String?
  provider    String?
  schema      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mcpServer      MCPServer?      @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  toolExecutions ToolExecution[]
}

// -------------------------------------------------------------
// Agents & Configurations
// -------------------------------------------------------------

model Agent {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String?           @db.Uuid
  key              String
  name             String
  description      String?           @db.Text
  type             String?
  version          String            @default("1.0.0")
  status           AgentStatus       @default(ACTIVE)
  healthStatus     AgentHealthStatus @default(HEALTHY)
  visibility       String            @default("PRIVATE")
  ownerWorkspaceId String?           @db.Uuid
  executionMode    String?
  defaultModel     String?
  maxConcurrency   Int               @default(1)
  costProfile      String?
  latencyProfile   String?
  
  // Operational fields
  currentLoad          Int       @default(0)
  runningExecutions    Int       @default(0)
  queuedExecutions     Int       @default(0)
  lastExecutionAt      DateTime?
  successRate          Float     @default(1.0)
  averageExecutionTime Int?      // in milliseconds
  
  tags             String[]
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  deletedBy        String?           @db.Uuid

  workspace     Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions      AgentVersion[]
  conversations Conversation[]
  capabilities  AgentCapability[]

  @@unique([workspaceId, key])
}

model Capability {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique
  name        String
  description         String?   @db.Text
  category            String?
  version             String    @default("1.0.0")
  inputSchema         Json?
  outputSchema        Json?
  requiredPermissions String[]
  createdAt           DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agents      AgentCapability[]
}

model AgentCapability {
  agentId       String            @db.Uuid
  capabilityId  String            @db.Uuid
  status        AgentStatus       @default(ACTIVE)
  healthStatus  AgentHealthStatus @default(HEALTHY)
  workspaceId   String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  agent         Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  capability    Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([agentId, capabilityId])
  @@index([capabilityId])
  @@index([status])
  @@index([healthStatus])
  @@index([workspaceId])
}

model AgentVersion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId      String    @db.Uuid
  systemPrompt String    @db.Text
  toolConfig   Json? // Tools enabled for this version
  variables    Json?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent  Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  models AgentModel[]
  runs   Run[]
}

model AgentModel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentVersionId String   @db.Uuid
  provider       String // e.g., 'openai', 'anthropic'
  model          String // e.g., 'gpt-4o'
  settings       Json? // e.g. { temperature, maxTokens, topP, etc }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// Execution & History
// -------------------------------------------------------------

model Conversation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId         String?   @db.Uuid
  workspaceId     String?   @db.Uuid
  title           String?
  summary         String?   @db.Text
  isAutoGenerated Boolean   @default(false)
  metadata        Json?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?
  deletedAt       DateTime?
  deletedBy       String?   @db.Uuid
  lastMessageAt   DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id])
  runs      Run[]
  messages  Message[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, lastMessageAt])
  @@index([lastMessageAt])
}

model Run {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId          String    @db.Uuid
  agentVersionId          String?   @db.Uuid
  status                  RunStatus @default(RUNNING)
  terminationReason       String?
  tokenUsage              Int       @default(0) // legacy, maybe remove later
  inputTokens             Int       @default(0)
  outputTokens            Int       @default(0)
  cachedTokens            Int       @default(0)
  reasoningTokens         Int       @default(0)
  toolCount               Int       @default(0)
  reasoningCount          Int       @default(0)
  totalTokens             Int       @default(0)
  currency                String?   @default("USD")
  estimatedCostMinorUnits Int       @default(0) // e.g. cents or micro-cents
  durationMs              Int?
  metadata                Json?
  version                 Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  endedAt                 DateTime?

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentVersion   AgentVersion?   @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  messages       Message[]
  executionNodes ExecutionNode[]

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model ExecutionNode {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String              @db.Uuid
  parentNodeId String?             @db.Uuid
  sequence     Int
  depth        Int                 @default(0)
  path         String?
  type         ExecutionNodeType
  status       ExecutionNodeStatus @default(PENDING)
  title        String?
  summary      String?             @db.Text
  artifactType String? // e.g. 'TOOL_EXECUTION', 'MEMORY_READ', 'PLANNER_STEP'
  artifactId   String?             @db.Uuid
  completedBy  String? // e.g. 'LLM', 'Human', 'Tool'
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?

  run            Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  parent         ExecutionNode?  @relation("ExecutionNodeHierarchy", fields: [parentNodeId], references: [id])
  children       ExecutionNode[] @relation("ExecutionNodeHierarchy")
  toolExecutions ToolExecution[]

  @@index([runId, sequence])
  @@index([depth])
}

model ToolExecution {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionNodeId String    @db.Uuid
  toolId          String?   @db.Uuid
  toolName        String
  provider        String?
  model           String?
  toolVersion     String?
  mcpServer       String?
  arguments       Json
  result          Json?
  success         Boolean
  error           String?   @db.Text
  retryCount      Int       @default(0)
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  cost            Int       @default(0)
  durationMs      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  executionNode ExecutionNode @relation(fields: [executionNodeId], references: [id], onDelete: Cascade)
  tool          Tool?         @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([executionNodeId])
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @db.Uuid
  runId          String?     @db.Uuid
  role           MessageRole
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          Run?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  parts        MessagePart[]

  @@index([conversationId, createdAt])
}

model MessagePart {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId  String            @db.Uuid
  type       MessagePartType
  status     MessagePartStatus @default(COMPLETE)
  order      Int
  content    Json
  metadata   Json?
  toolCallId String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, order])
}

// -------------------------------------------------------------
// Human Approval (Phase 2)
// -------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String         @db.Uuid
  toolName    String
  args        Json
  status      ApprovalStatus @default(PENDING)
  decidedAt   DateTime?
  deciderNote String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([runId, status])
}

// -------------------------------------------------------------
// Episodic Memory (Phase 3)
// -------------------------------------------------------------

model EpisodicMemory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String?  @db.Uuid
  agentId     String?  @db.Uuid
  runId       String?  @db.Uuid
  summary     String   @db.Text
  importance  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId])
}

// -------------------------------------------------------------
// Workflows (Phase 4)
// -------------------------------------------------------------

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Workflow {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @db.Uuid
  name        String
  description String?        @db.Text
  graph       Json
  status      WorkflowStatus @default(DRAFT)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  runs WorkflowRun[]

  @@index([workspaceId, status])
}

model WorkflowRun {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId String            @db.Uuid
  status     WorkflowRunStatus @default(PENDING)
  context    Json?
  result     Json?
  error      String?           @db.Text
  startedAt  DateTime          @default(now())
  endedAt    DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
}

// -------------------------------------------------------------
// Scheduler (Phase 6)
// -------------------------------------------------------------

model ScheduledJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  agentId     String?   @db.Uuid
  name        String
  cronExpr    String
  goal        String    @db.Text
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, enabled])
}
