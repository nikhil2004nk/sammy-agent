datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents    Agent[]
}

model Agent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?  @db.Uuid
  name         String
  systemPrompt String   @db.Text
  capabilities Json     // Array of allowed tools
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  modelConfigs  ModelConfig[]
}

model ModelConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId     String   @db.Uuid
  provider    String   // e.g., 'openai', 'anthropic'
  model       String   // e.g., 'gpt-4o'
  temperature Float    @default(0.7)
  maxTokens   Int      @default(2000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent       Agent    @relation(fields: [agentId], references: [id])
}

model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId   String?  @db.Uuid
  tenantId  String?  @db.Uuid
  userId    String
  title     String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent     Agent?      @relation(fields: [agentId], references: [id])
  runs      Run[]
  messages  Message[]
}

model Run {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String   @db.Uuid
  status            String   // 'running', 'completed', 'failed', 'cancelled', 'requires_action'
  terminationReason String?
  tokenUsage        Int      @default(0)
  metadata          Json?
  createdAt         DateTime @default(now())
  endedAt           DateTime?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages          Message[]
  reasoningSteps    ReasoningStep[]
  events            Event[]
}

model ReasoningStep {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String   @db.Uuid
  stepIndex   Int
  status      String   // 'started', 'completed', 'failed'
  createdAt   DateTime @default(now())
  completedAt DateTime?

  run            Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolExecutions ToolExecution[]
}

model Message {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String   @db.Uuid
  runId             String?  @db.Uuid
  role              String   // 'user', 'assistant', 'system', 'tool'
  content           String?  @db.Text
  structuredContent Json?    // To hold objects like tool results, complex schemas
  toolCalls         Json?
  toolCallId        String?
  toolName          String?
  metadata          Json?
  createdAt         DateTime @default(now())

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run               Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)
}

model ToolExecution {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reasoningStepId String   @db.Uuid
  toolName        String
  arguments       Json
  result          Json?
  success         Boolean
  error           String?  @db.Text
  durationMs      Int?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  reasoningStep   ReasoningStep @relation(fields: [reasoningStepId], references: [id], onDelete: Cascade)
}

enum EventType {
  RunStarted
  RunCompleted
  ReasoningStarted
  ReasoningCompleted
  ToolStarted
  ToolCompleted
  ToolFailed
  ContextBuilt
  LLMCalled
  LLMResponded
  HumanApprovalRequested
  PlannerInvoked
}

model Event {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String   @db.Uuid
  eventType   EventType
  payload     Json?
  createdAt   DateTime @default(now())

  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

