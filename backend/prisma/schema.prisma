datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -------------------------------------------------------------
// Identity & Workspace Foundation
// -------------------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]
}

model Session {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       WorkspaceMember[]
  connections   Connection[]
  agents        Agent[]
  conversations Conversation[]
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model WorkspaceMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Connection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  provider    String   // e.g., 'gmail', 'github'
  status      String   // 'active', 'error', 'pending'
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// Platform Models
// -------------------------------------------------------------

model Agent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String?  @db.Uuid
  name         String
  systemPrompt String   @db.Text
  capabilities Json     // Array of allowed tools
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  modelConfigs  ModelConfig[]
}

model ModelConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId     String   @db.Uuid
  provider    String   // e.g., 'openai', 'anthropic'
  model       String   // e.g., 'gpt-4o'
  temperature Float    @default(0.7)
  maxTokens   Int      @default(2000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId     String?  @db.Uuid
  workspaceId String?  @db.Uuid
  title       String?
  metadata    Json?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?     @relation(fields: [agentId], references: [id])
  runs      Run[]
  messages  Message[]
  events    Event[]
}

model Run {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String   @db.Uuid
  status            String   // 'running', 'completed', 'failed', 'cancelled', 'requires_action'
  terminationReason String?
  tokenUsage        Int      @default(0)
  toolCount         Int      @default(0)
  reasoningCount    Int      @default(0)
  totalTokens       Int      @default(0)
  estimatedCost     Float    @default(0)
  durationMs        Int?
  metadata          Json?
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  endedAt           DateTime?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages          Message[]
  reasoningSteps    ReasoningStep[]
  events            Event[]
  executionNodes    ExecutionNode[]
}

model ExecutionNode {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId           String   @db.Uuid
  parentNodeId    String?  @db.Uuid
  sequence        Int
  type            String   // 'reasoning', 'tool', 'planner', 'workflow', 'approval', 'message'
  status          String
  title           String?
  summary         String?  @db.Text
  referenceType   String?
  referenceId     String?  @db.Uuid
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?

  run             Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  parent          ExecutionNode? @relation("ExecutionNodeHierarchy", fields: [parentNodeId], references: [id])
  children        ExecutionNode[] @relation("ExecutionNodeHierarchy")
}

model ReasoningStep {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String   @db.Uuid
  stepIndex   Int
  status      String   // 'started', 'completed', 'failed'
  createdAt   DateTime @default(now())
  completedAt DateTime?

  run            Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolExecutions ToolExecution[]
  events         Event[]
}

model Message {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String   @db.Uuid
  runId             String?  @db.Uuid
  role              String   // 'user', 'assistant', 'system', 'tool'
  content           String?  @db.Text
  structuredContent Json?    // To hold objects like tool results, complex schemas
  toolCalls         Json?
  toolCallId        String?
  toolName          String?
  metadata          Json?
  createdAt         DateTime @default(now())

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run               Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)
}

model ToolExecution {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reasoningStepId String   @db.Uuid
  toolName        String
  arguments       Json
  result          Json?
  success         Boolean
  error           String?  @db.Text
  durationMs      Int?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  reasoningStep   ReasoningStep @relation(fields: [reasoningStepId], references: [id], onDelete: Cascade)
}

enum EventType {
  RunStarted
  RunCompleted
  ReasoningStarted
  ReasoningCompleted
  ToolStarted
  ToolCompleted
  ToolFailed
  ContextBuilt
  LLMCalled
  LLMResponded
  HumanApprovalRequested
  PlannerInvoked
}

model Event {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String   @db.Uuid
  runId           String?  @db.Uuid
  reasoningStepId String?  @db.Uuid
  eventType       EventType
  payload         Json?
  createdAt       DateTime @default(now())

  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run             Run?           @relation(fields: [runId], references: [id], onDelete: Cascade)
  reasoningStep   ReasoningStep? @relation(fields: [reasoningStepId], references: [id], onDelete: Cascade)
}
